{
  "name": "@hulala/website",
  "version": "0.1.4",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "build:cloudflare": "bun scripts/build-cloudflare.ts",
    "deploy:cloudflare": "bun run build:cloudflare && wrangler deploy --config wrangler.cloudflare.jsonc",
    "build:downloads": "bun scripts/build-downloads.ts",
    "deploy:downloads": "bun run build:downloads && wrangler deploy --config wrangler.downloads.jsonc"
  },
  "dependencies": {
    "@hulala/desktop-contracts": "workspace:*",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "react-server-dom-webpack": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
