{
  "name": "@loopwithai/harness-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:plugins": "bun run --filter @loopwithai/dsh-network-proxy build && bun run --filter @loopwithai/dsh-agent-loop-selector build && bun run --filter @loopwithai/dsh-agent-loop-pi build && bun run --filter @loopwithai/dsh-agent-loop-codex build && bun run --filter @loopwithai/dsh-agent-loop-claude build",
    "dev": "npm run build:plugins && tsx ./scripts/dev.ts",
    "dev:ui": "cd ../../packages/agent-loop-selector && vite",
    "dev:server": "tsx ./scripts/run-harness.ts --port 3210",
    "build": "npm run build:plugins && tsx ./scripts/run-harness.ts --dump-config > /dev/null",
    "start": "npm run build:plugins && tsx ./scripts/run-harness.ts --port 3210",
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.6",
    "@deepseek-ai/dsh-agent-loop": "0.1.0-rc.6",
    "@loopwithai/dsh-network-proxy": "*",
    "@loopwithai/runtime": "*",
    "@loopwithai/dsh-agent-loop-claude": "*",
    "@loopwithai/dsh-agent-loop-codex": "*",
    "@loopwithai/dsh-agent-loop-selector": "*",
    "@loopwithai/dsh-agent-loop-pi": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0"
  }
}
