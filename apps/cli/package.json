    "test": "bun test tests",
    "typecheck": "tsc --noEmit",
    "prepack": "bun scripts/release-only.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.0",
    "@types/bun": "1.3.14"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "homepage": "https://hulala.ai",
  "repository": {
    "type": "git",
