{
  "name": "hulala",
  "version": "0.1.6",
  "description": "Launch the local-first Hulala Agent workbench with one npx command.",
  "type": "module",
  "bin": {
    "hulala": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
