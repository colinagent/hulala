{
  "name": "@loopwithai/dsh-llm-deepseek",
  "description": "DeepSeek chat-completions adapter for the DeepSeek Harness LLM seam",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-deepseek"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/dsh-credentials": "*",
    "@loopwithai/dsh-launch-environment": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-settings": "*",
    "@loopwithai/dsh-timeout": "*",
    "@loopwithai/dsh-anonymous-user-id": "*",
    "@loopwithai/cordis": "*"
  },
  "dependencies": {
    "eventsource-parser": "^3.1.0",
    "@loopwithai/schemastery": "*"
  },
  "devDependencies": {
    "@loopwithai/dsh-credentials": "*",
    "@loopwithai/dsh-launch-environment": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-settings": "*",
    "@loopwithai/dsh-timeout": "*",
    "@loopwithai/dsh-anonymous-user-id": "*",
    "@loopwithai/cordis": "*"
  },
  "private": true
}
