{
  "name": "@loopwithai/dsh-anonymous-user-id",
  "description": "Shared anonymous user identity for DeepSeek Harness telemetry and feedback correlation",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/identity/anonymous-user-id"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-home-paths": "*",
    "@loopwithai/cordis": "*"
  },
  "devDependencies": {
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-home-paths": "*",
    "@loopwithai/cordis": "*"
  },
  "private": true
}
