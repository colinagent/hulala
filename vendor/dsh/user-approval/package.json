{
  "name": "@loopwithai/dsh-user-approval",
  "description": "User-approval seam (ctx.approval) for the DeepSeek Harness: one-shot permission decisions dispatched to composed answerers over the approval/request waterfall, fail-closed by default",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/interaction/user-approval"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/dsh-agent": "*",
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-session": "*",
    "@loopwithai/dsh-system-prompt": "*",
    "@loopwithai/cordis": "*"
  },
  "dependencies": {
    "@loopwithai/schemastery": "*"
  },
  "devDependencies": {
    "@loopwithai/dsh-agent": "*",
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-session": "*",
    "@loopwithai/dsh-system-prompt": "*",
    "@loopwithai/cordis": "*"
  },
  "private": true
}
