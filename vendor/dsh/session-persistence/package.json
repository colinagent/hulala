{
  "name": "@hulala/dsh-session-persistence",
  "description": "Abstract durable session persistence seam (ctx.sessionPersistence) for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-persistence"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hulala/dsh-brand": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-session": "*",
    "@hulala/dsh-timeout": "*",
    "@hulala/cordis": "*"
  },
  "devDependencies": {
    "@hulala/dsh-brand": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-scope": "*",
    "@hulala/dsh-session": "*",
    "@hulala/dsh-timeout": "*",
    "@hulala/cordis": "*"
  },
  "private": true
}
