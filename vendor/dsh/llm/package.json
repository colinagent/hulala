{
  "name": "@hulala/dsh-llm",
  "description": "Provider-neutral LLM service interface for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./brand": {
      "types": "./lib/types/brand.d.ts",
      "default": "./lib/types/brand.js"
    },
    "./message": {
      "types": "./lib/types/message.d.ts",
      "default": "./lib/types/message.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hulala/dsh-attachment": "*",
    "@hulala/dsh-brand": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-timeout": "*",
    "@hulala/cordis": "*"
  },
  "dependencies": {
    "@hulala/schemastery": "*"
  },
  "devDependencies": {
    "@hulala/dsh-attachment": "*",
    "@hulala/dsh-brand": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-timeout": "*",
    "@hulala/cordis": "*"
  },
  "private": true
}
