{
  "name": "@loopwithai/dsh-session",
  "description": "Event-sourced session store for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/session"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./surface": {
      "types": "./lib/types/surface.d.ts",
      "default": "./lib/types/surface.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-typert-protocol": "*",
    "@loopwithai/cordis": "*"
  },
  "devDependencies": {
    "@loopwithai/dsh-brand": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-typert-protocol": "*",
    "@loopwithai/cordis": "*"
  },
  "private": true
}
