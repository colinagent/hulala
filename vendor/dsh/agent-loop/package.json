{
  "name": "@hulala/dsh-agent-loop",
  "description": "The concrete agent loop plugin for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/agent-loop"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@hulala/dsh-agent": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-llm": "*",
    "@hulala/dsh-scope": "*",
    "@hulala/dsh-session": "*",
    "@hulala/dsh-session-persistence": "*",
    "@hulala/dsh-system-prompt": "*",
    "@hulala/dsh-tools": "*",
    "@hulala/cordis": "*",
    "@hulala/dsh-settings": "*"
  },
  "dependencies": {
    "@hulala/schemastery": "*"
  },
  "devDependencies": {
    "@hulala/dsh-agent": "*",
    "@hulala/dsh-invariants": "*",
    "@hulala/dsh-llm": "*",
    "@hulala/dsh-scope": "*",
    "@hulala/dsh-session": "*",
    "@hulala/dsh-session-persistence": "*",
    "@hulala/dsh-system-prompt": "*",
    "@hulala/dsh-tools": "*",
    "@hulala/cordis": "*",
    "@hulala/dsh-settings": "*"
  },
  "private": true
}
