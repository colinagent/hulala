{
  "name": "@loopwithai/dsh-tools",
  "description": "Tool registry and execution pipeline for the DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/core/tools"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./presentation": {
      "types": "./lib/types/presentation.d.ts",
      "default": "./lib/types/presentation.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/dsh-agent": "*",
    "@loopwithai/dsh-code-runtime": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-session": "*",
    "@loopwithai/dsh-system-prompt": "*",
    "@loopwithai/dsh-user-approval": "*",
    "@loopwithai/cordis": "*"
  },
  "dependencies": {
    "@loopwithai/schemastery": "*"
  },
  "devDependencies": {
    "@loopwithai/dsh-agent": "*",
    "@loopwithai/dsh-code-runtime": "*",
    "@loopwithai/dsh-invariants": "*",
    "@loopwithai/dsh-llm": "*",
    "@loopwithai/dsh-scope": "*",
    "@loopwithai/dsh-session": "*",
    "@loopwithai/dsh-system-prompt": "*",
    "@loopwithai/dsh-user-approval": "*",
    "@loopwithai/cordis": "*"
  },
  "private": true
}
