{
  "name": "@loopwithai/cordis-plugin-loader",
  "description": "Plugin loader for cordis",
  "version": "1.0.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/loader"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "lib/types/**/*.d.ts.map",
    "src"
  ],
  "author": "Shigma <shigma10826@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@loopwithai/cordis": "*",
    "node-addon-require-builtin": "^0.1.4"
  },
  "peerDependenciesMeta": {
    "node-addon-require-builtin": {
      "optional": true
    }
  },
  "dependencies": {
    "@loopwithai/cosmokit": "*"
  },
  "private": true
}
