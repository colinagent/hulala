{
  "name": "@loopwithai/cordis-plugin-group",
  "description": "Nested plugin group for cordis",
  "version": "1.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "vendor/group"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
