{
  "name": "@hulala/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    }
  },
  "bin": {
    "hulala-runtime": "./lib/cli.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts src/bun-lifecycle.ts --target=bun --outdir=lib",
    "build:portable": "bun scripts/build-portable.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh": "0.1.0-rc.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.0"
  }
}
