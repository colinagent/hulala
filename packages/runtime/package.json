{
  "name": "@hulala/runtime",
  "version": "0.2.24",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./host": {
      "types": "./src/in-process.ts",
      "default": "./src/in-process.ts"
    },
    "./creator": {
      "types": "./src/creator.ts",
      "default": "./src/creator.ts"
    }
  },
  "bin": {
    "hulala-runtime": "./lib/cli.js"
  },
  "scripts": {
    "build": "bun build src/index.ts src/cli.ts src/creator.ts --target=bun --outdir=lib && bun build src/in-process.ts --target=bun --packages external --outdir=lib",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-group": "1.1.0",
    "@deepseek-ai/cordis-plugin-hmr": "1.1.0",
    "@deepseek-ai/cordis-plugin-include": "1.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-settings-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.1",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.1",
    "@deepseek-ai/dsh-atomic-write": "0.2.2-rc.1",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.1",
    "@deepseek-ai/dsh-bash-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-file-upload": "0.2.2-rc.1",
    "@deepseek-ai/dsh-cmdline": "0.2.2-rc.1",
    "@deepseek-ai/dsh-compaction": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.2-rc.1",
    "@deepseek-ai/dsh-home-paths": "0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "0.2.2-rc.1",
    "@deepseek-ai/dsh-output-retention": "0.2.2-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-telemetry": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-title-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-shell": "0.2.2-rc.1",
    "@deepseek-ai/dsh-spill": "0.2.2-rc.1",
    "@deepseek-ai/dsh-subagent-spawn-in-process": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workflow": "0.2.2-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.1",
    "koffi": "3.1.6",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^7.0.0"
  },
  "license": "GPL-3.0-only"
}
