{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": false,
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "paths": {
      "@hulala/cosmokit": ["./vendor/cordis/cosmokit/src/index.ts"],
      "@hulala/cordis": ["./vendor/cordis/cordis/src/index.ts"]
    }
  },
  "include": [
    "vendor/cordis/cosmokit/src/**/*.ts",
    "vendor/cordis/cordis/src/**/*.ts"
  ]
}
